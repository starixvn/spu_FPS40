<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
    </startup>
  <appSettings>
    <add key="AppData-Path" value="~/App_Data/NAPFPSNames.xml" />

    <add key="Queue-Host" value="ha.nexdev.net" />
    <add key="Queue-Port" value="5672" />
    <add key="Queue-VirtualHost" value="/FPS_Oneye_Service" />
    <add key="Queue-UserName" value="fps" />
    <add key="Queue-Password" value="fps" />
    <add key="Queue-PrefetchCount" value="1" />
    <add key="Queue-Exchange" value="fpstransExchange" />
  </appSettings>
</configuration>