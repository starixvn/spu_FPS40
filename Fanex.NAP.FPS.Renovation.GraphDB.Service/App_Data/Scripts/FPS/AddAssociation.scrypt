MERGE (cus:Customer {CustId:$CustId})
ON CREATE SET cus.Username		= $Username
			, cus.Username2		= $Username2
			, cus.RoleId		= $RoleId
			, cus.CurrencyID	= $CurrencyID
			, cus.CurrencyName	= $CurrencyName
			, cus.CreatedDate	= $AccountCreatedDate
MERGE (dev:Device {DeviceId:$DeviceId})
MERGE (cus) -[:USED {CreatedDate: $AssociatedDate}]-> (dev)